# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=capital_hospital

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - your deployed frontend URL(s), comma separated
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# --- Optional integrations (leave blank until you have real accounts) ---
# Razorpay / Stripe for real billing payments
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# Twilio for SMS appointment reminders
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid / SMTP for email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Admin bootstrap account (created automatically on first backend start)
ADMIN_EMAIL=admin@capitalhospital.local
ADMIN_PASSWORD=ChangeMe123!

# Google OAuth - from Google Cloud Console > APIs & Services > Credentials
# (OAuth 2.0 Client ID, type "Web application")
GOOGLE_CLIENT_ID=

OTP_EXPIRE_MINUTES=10
